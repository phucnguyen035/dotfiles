theme = dark:Catppuccin Mocha,light:Catppuccin Latte
#command = /opt/homebrew/bin/fish -l -c "zellij -l welcome"
shell-integration = fish
shell-integration-features = true
adjust-cell-height = 10%
window-padding-x = 10
window-height = 50
window-width = 200

font-size = 14
font-family = Maple Mono Normal NF
font-feature = -calt, cv01, cv02, zero
font-variation-italic = wght=200
font-thicken = true

custom-shader = ./shaders/cursor_warp.glsl

macos-option-as-alt = true
macos-titlebar-style = tabs

keybind = shift+enter=text:\x1b\r
# conflict with zellij
keybind = alt+left=unbind
keybind = alt+right=unbind
keybind = super+r=prompt_tab_title
# conflict with herdr prefix (ctrl+a): defaults send \x01 / \x05
# Change to Home/End
keybind = super+arrow_left=text:\x1b[H
keybind = super+arrow_right=text:\x1b[F
